{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/about-us", "destination": "/pages/about-us" },
    { "source": "/products", "destination": "/pages/products" },
    { "source": "/products/:slug", "destination": "/pages/product-detail" },
    { "source": "/market", "destination": "/pages/market" },
    { "source": "/corporate-responsibility", "destination": "/pages/corporate-responsibility" },
    { "source": "/contact-us", "destination": "/pages/contact-us" },
    { "source": "/marcas", "destination": "/pages/marcas" },
    { "source": "/blog", "destination": "/pages/blog/index" },
    { "source": "/blog/:slug", "destination": "/pages/blog/article" },
    { "source": "/admin", "destination": "/admin/dashboard" },
    { "source": "/admin/login", "destination": "/admin/login" },
    { "source": "/admin/products", "destination": "/admin/products" },
    { "source": "/admin/news", "destination": "/admin/news" },
    { "source": "/admin/pages", "destination": "/admin/pages" },
    { "source": "/admin/contacts", "destination": "/admin/contacts" },
    { "source": "/admin/careers", "destination": "/admin/careers" },
    { "source": "/admin/media", "destination": "/admin/media" },
    { "source": "/admin/users", "destination": "/admin/users" },
    { "source": "/admin/settings", "destination": "/admin/settings" }
  ]
}
