{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about-us", "destination": "/pages/about-us.html" },
    { "source": "/products", "destination": "/pages/products.html" },
    { "source": "/products/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/market", "destination": "/pages/market.html" },
    { "source": "/corporate-responsibility", "destination": "/pages/corporate-responsibility.html" },
    { "source": "/contact-us", "destination": "/pages/contact-us.html" },
    { "source": "/marcas", "destination": "/pages/marcas.html" },
    { "source": "/blog", "destination": "/pages/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/pages/blog/article.html" },
    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/products", "destination": "/admin/products.html" },
    { "source": "/admin/news", "destination": "/admin/news.html" },
    { "source": "/admin/pages", "destination": "/admin/pages.html" },
    { "source": "/admin/contacts", "destination": "/admin/contacts.html" },
    { "source": "/admin/careers", "destination": "/admin/careers.html" },
    { "source": "/admin/media", "destination": "/admin/media.html" },
    { "source": "/admin/users", "destination": "/admin/users.html" },
    { "source": "/admin/settings", "destination": "/admin/settings.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/pages/about-us.html", "destination": "/about-us", "permanent": true },
    { "source": "/pages/products.html", "destination": "/products", "permanent": true },
    { "source": "/pages/market.html", "destination": "/market", "permanent": true },
    { "source": "/pages/corporate-responsibility.html", "destination": "/corporate-responsibility", "permanent": true },
    { "source": "/pages/contact-us.html", "destination": "/contact-us", "permanent": true },
    { "source": "/pages/marcas.html", "destination": "/marcas", "permanent": true }
  ]
}

