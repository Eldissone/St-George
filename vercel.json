{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/css/:path*", "destination": "/frontend/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/js/:path*" },
    { "source": "/assets/:path*", "destination": "/frontend/assets/:path*" },
    { "source": "/about-us", "destination": "/frontend/pages/about-us.html" },
    { "source": "/products", "destination": "/frontend/pages/products.html" },
    { "source": "/products/:slug", "destination": "/frontend/pages/product-detail.html" },
    { "source": "/market", "destination": "/frontend/pages/market.html" },
    { "source": "/corporate-responsibility", "destination": "/frontend/pages/corporate-responsibility.html" },
    { "source": "/contact-us", "destination": "/frontend/pages/contact-us.html" },
    { "source": "/marcas", "destination": "/frontend/pages/marcas.html" },
    { "source": "/blog", "destination": "/frontend/pages/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/frontend/pages/blog/article.html" },
    { "source": "/admin", "destination": "/frontend/admin/dashboard.html" },
    { "source": "/admin/login", "destination": "/frontend/admin/login.html" },
    { "source": "/admin/products", "destination": "/frontend/admin/products.html" },
    { "source": "/admin/news", "destination": "/frontend/admin/news.html" },
    { "source": "/admin/pages", "destination": "/frontend/admin/pages.html" },
    { "source": "/admin/contacts", "destination": "/frontend/admin/contacts.html" },
    { "source": "/admin/careers", "destination": "/frontend/admin/careers.html" },
    { "source": "/admin/media", "destination": "/frontend/admin/media.html" },
    { "source": "/admin/users", "destination": "/frontend/admin/users.html" },
    { "source": "/admin/settings", "destination": "/frontend/admin/settings.html" }
  ]
}
